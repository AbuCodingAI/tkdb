---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page does not exist." noindex>
  <div class="container error-page">
    <div class="code">404</div>
    <h1>Kernel panic: page not found</h1>
    <p class="lede muted">The page you wanted moved, never existed, or is still a draft.</p>
    <div class="hero-actions" style="justify-content:center">
      <a class="btn primary" href="/">Back home</a>
      <a class="btn" href="/search/">Search</a>
    </div>
  </div>
</BaseLayout>
