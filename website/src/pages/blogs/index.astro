---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import PostCard from '../../components/PostCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getBlogs, getPosts, postsForBlog } from '../../lib/content';
const [blogs, posts] = await Promise.all([getBlogs(), getPosts()]);
// getPosts() is already sorted newest first.
// Featured: the "10 files" Linux post (falls back to the newest post). posts is sorted newest first.
const lead = posts.find((p) => p.url.includes('inside-linux-10-files')) ?? posts[0];
// More stories: the newest story from 3 different blogs, excluding the featured post and its blog.
const seen = new Set(lead ? [lead.blog.id] : []);
const more = [];
for (const p of posts) { if (more.length < 3 && p !== lead && !seen.has(p.blog.id)) { seen.add(p.blog.id); more.push(p); } }
---

<BaseLayout title="Blogs" description="The latest stories on TKDB, and every blog hosted here.">
  <div class="container">
    <header class="page-head">
      <p class="kicker">Latest</p>
      <h1>Blogs</h1>
    </header>

    <section class="section" aria-labelledby="pinned-h" data-saved-section hidden>
      <SectionHead id="pinned-h" title="Your pinned articles" href="/saved/" linkText="All saved →" />
      <div class="grid" data-saved-list="pin"></div>
    </section>

    {lead && (
      <section aria-labelledby="top-story-h">
        <h2 id="top-story-h" class="sr-only">Top story</h2>
        <div class="grid two"><PostCard post={lead} featured={true} /></div>
      </section>
    )}

    {more.length > 0 && (
      <section class="section" aria-labelledby="more-stories-h">
        <SectionHead id="more-stories-h" title="More stories" />
        <div class="grid">{more.map((p, i) => <PostCard post={p} delay={i * 50} />)}</div>
      </section>
    )}

    <section class="section" aria-labelledby="all-blogs-h">
      <SectionHead id="all-blogs-h" title="All blogs" />
      <p class="lede">Independent blogs under one roof. Each has its own feed, categories, tags and RSS.</p>
      {blogs.length ? (
        <div class="grid">{blogs.map((b, i) => <BlogCard blog={b} count={postsForBlog(posts, b.id).length} delay={i * 60} />)}</div>
      ) : (
        <EmptyState title="No blogs yet">Create one with <code>npm run new:blog</code>.</EmptyState>
      )}
    </section>
  </div>
</BaseLayout>
