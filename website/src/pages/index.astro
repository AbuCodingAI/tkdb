---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import PostCard from '../components/PostCard.astro';
import BlogCard from '../components/BlogCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PaperCard from '../components/PaperCard.astro';
import VideoCard from '../components/VideoCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { SITE } from '../config';
import { getBlogs, getPosts, getProjects, getPapers, getVideos, postsForBlog } from '../lib/content';

const [blogs, posts, projects, papers, videos] = await Promise.all([getBlogs(), getPosts(), getProjects(), getPapers(), getVideos()]);
const featuredList = posts.filter((p) => p.data.featured || p.slug === p.blog.data.featured);
const featured = (featuredList.length ? featuredList : posts).slice(0, 3);
const latest = posts.filter((p) => !featured.includes(p)).slice(0, 6);
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <p class="kicker">The Kernel Daily Blog</p>
      <h1>{SITE.tagline}</h1>
      <p class="lede">{SITE.description}</p>
      <form class="search-box" action="/search/" method="get" role="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <label class="sr-only" for="home-q">Search TKDB</label>
        <input id="home-q" name="q" type="search" placeholder="Search posts, projects, papers…" autocomplete="off" />
      </form>
      <div class="hero-actions">
        <a class="btn primary" href="/blogs/">Browse blogs</a>
        <a class="btn" href="/projects/">See projects</a>
      </div>
      <div class="stats" aria-label="Site at a glance">
        <div><strong>{blogs.length}</strong><span>Blogs</span></div>
        <div><strong>{posts.length}</strong><span>Posts</span></div>
        <div><strong>{projects.length}</strong><span>Projects</span></div>
        <div><strong>{papers.length}</strong><span>Papers</span></div>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="featured-h">
    <SectionHead id="featured-h" title="Featured" />
    {featured.length ? (
      <div class="grid two">{featured.map((p, i) => <PostCard post={p} featured={i === 0} delay={i * 70} />)}</div>
    ) : (
      <EmptyState title="Nothing featured yet">Mark a post with <code>featured: true</code> to pin it here.</EmptyState>
    )}
  </section>

  {latest.length > 0 && (
    <section class="section container" aria-labelledby="latest-h">
      <SectionHead id="latest-h" title="Latest across all blogs" />
      <div class="grid">{latest.map((p, i) => <PostCard post={p} delay={i * 50} />)}</div>
    </section>
  )}

  <section class="section container" aria-labelledby="blogs-h">
    <SectionHead id="blogs-h" title="Blog directory" href="/blogs/" linkText="All blogs →" />
    <div class="grid">{blogs.map((b, i) => <BlogCard blog={b} count={postsForBlog(posts, b.id).length} delay={i * 50} />)}</div>
  </section>

  <section class="section container" aria-labelledby="projects-h">
    <SectionHead id="projects-h" title="Recent projects" href="/projects/" />
    {projects.length ? (
      <div class="grid">{projects.slice(0, 3).map((p, i) => <ProjectCard project={p} delay={i * 50} />)}</div>
    ) : (
      <EmptyState title="No projects yet">Add one in <code>src/content/projects/</code>.</EmptyState>
    )}
  </section>

  <section class="section container" aria-labelledby="papers-h">
    <SectionHead id="papers-h" title="Papers" href="/papers/" />
    {papers.length ? (
      <div class="grid">{papers.slice(0, 3).map((p, i) => <PaperCard paper={p} delay={i * 50} />)}</div>
    ) : (
      <EmptyState title="No papers published yet">Original papers will appear here once added to <code>src/content/papers/</code>.</EmptyState>
    )}
  </section>

  <section class="section container" aria-labelledby="videos-h">
    <SectionHead id="videos-h" title="Videos" href="/videos/" />
    {videos.length ? (
      <div class="grid">{videos.slice(0, 3).map((v, i) => <VideoCard video={v} delay={i * 50} />)}</div>
    ) : (
      <EmptyState title="No videos yet">Add a YouTube video in <code>src/content/videos/</code>.</EmptyState>
    )}
  </section>
</BaseLayout>
