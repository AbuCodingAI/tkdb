---
import type { MarkdownHeading } from 'astro';
import type { Post } from '../../lib/content';
import Cover from '../../components/Cover.astro';
import PostMeta from '../../components/PostMeta.astro';
import PostNotices from '../../components/PostNotices.astro';
import TagRow from '../../components/TagRow.astro';
import Toc from '../../components/Toc.astro';
interface Props { post: Post; headings: MarkdownHeading[] }
const { post, headings } = Astro.props;
const { data, blog } = post;
---

<article class="container" style={`--accent:${blog.data.accent}`}>
  <header class="article-head narrow" style="margin-inline:0;width:min(100%,50rem)">
    <p class="kicker">Research article</p>
    <h1>{data.title}</h1>
    <PostMeta post={post} />
    {data.abstract && (
      <section class="abstract" aria-labelledby="abstract-h"><h2 id="abstract-h">Abstract</h2><p>{data.abstract}</p></section>
    )}
  </header>
  <PostNotices post={post} />
  {data.cover && <Cover class="article-cover" src={data.cover} alt={data.coverAlt} eager />}
  <div class="layout-2" style="padding-top:0">
    <div>
      <div class="prose"><slot /></div>
      {data.sources.length > 0 && (
        <section class="sources" aria-labelledby="sources-h">
          <h2 id="sources-h">Sources</h2>
          <ol>{data.sources.map((s) => <li><a href={s.url} rel="noopener noreferrer">{s.title}</a></li>)}</ol>
        </section>
      )}
      <TagRow blogUrl={blog.url} tags={data.tags} />
    </div>
    <aside class="sidebar" style="position:sticky;top:5.5rem;align-self:start"><Toc headings={headings} /></aside>
  </div>
</article>
